rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SHARED SECURE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Attribute-Based role access check from user's master record
    function isLeaderOrAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'priest' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'deacon' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'bishop' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'parish leader' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'catechist' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'leader'
        )
      );
    }

    // --- USER PROFILE RULES ---
    match /user_profiles/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false; // Profiles cannot be deleted from the client to prevent state loss
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 256
        && data.role is string
        && data.streak is int
        && data.points is int;
    }

    // --- CHAT MESSAGES RULES ---
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidChatMessage(incoming());
      allow update, delete: if false; // Chat history integrity is fully immutable on the client
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.senderId is string
        && data.senderName is string && data.senderName.size() <= 100
        && data.text is string && data.text.size() <= 10000
        && data.timestamp is string;
    }

    // --- GOOGLE MEET SPACES RULES ---
    match /meet_spaces/{spaceId} {
      allow read: if true;
      allow create, update, delete: if isValidId(spaceId) && isValidMeetSpace(incoming());
    }

    function isValidMeetSpace(data) {
      return data.title is string && data.title.size() <= 100
        && data.meetingUri is string && data.meetingUri.size() <= 250
        && data.creatorId is string
        && data.creatorName is string && data.creatorName.size() <= 100
        && data.createdAt is string;
    }

    // --- DISCUSSION BOARD RULES ---
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isValidId(postId) && isValidPost(incoming());
    }

    function isValidPost(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 50000
        && data.category is string
        && data.authorId is string
        && data.authorName is string && data.authorName.size() <= 100
        && data.timestamp is string;
    }

    // --- OCIA REGISTRATIONS RULES ---
    match /ocia_registrations/{registrationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // --- POLLS RULES ---
    match /polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isValidId(pollId) && isValidPoll(incoming());
    }

    function isValidPoll(data) {
      return data.id is string && data.id.size() <= 128
        && data.question is string && data.question.size() <= 500
        && data.options is list
        && data.authorId is string
        && data.authorName is string && data.authorName.size() <= 100
        && data.timestamp is string;
    }
  }
}
