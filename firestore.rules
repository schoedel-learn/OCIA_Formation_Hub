rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- SHARED SECURE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Attribute-Based role access check from user's master record
    function isLeaderOrAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'priest' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'deacon' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'bishop' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'parish leader' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'catechist' ||
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'leader'
        )
      );
    }

    // --- USER PROFILE RULES ---
    match /user_profiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && (
        // Protect role mutations and identity fields
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'id', 'email'])
      );
      allow delete: if false; // Profiles cannot be deleted from the client to prevent state loss
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 256
        && data.role is string
        && data.streak is int
        && data.points is int
        && data.avatar is string
        && data.notificationsEnabled is bool;
    }

    // --- CHAT MESSAGES RULES ---
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming());
      allow update, delete: if false; // Chat history integrity is fully immutable on the client
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128
        && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() <= 100
        && data.senderAvatar is string
        && data.text is string && data.text.size() <= 10000
        && data.timestamp is string
        && data.room is string && data.room.size() <= 100;
    }

    // --- GOOGLE MEET SPACES RULES ---
    match /meet_spaces/{spaceId} {
      allow read: if true;
      allow create: if isLeaderOrAdmin() && isValidId(spaceId) && isValidMeetSpace(incoming());
      allow update: if false; // Spaces are simple configurations and immutable on updates
      allow delete: if isLeaderOrAdmin() || (isSignedIn() && existing().creatorId == request.auth.uid);
    }

    function isValidMeetSpace(data) {
      return data.title is string && data.title.size() <= 100
        && data.meetingUri is string && data.meetingUri.size() <= 250
        && data.creatorId == request.auth.uid
        && data.creatorName is string && data.creatorName.size() <= 100
        && data.creatorAvatar is string
        && data.createdAt is string;
    }

    // --- DISCUSSION BOARD RULES ---
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());
      allow update: if isSignedIn() && isValidId(postId) && isValidPost(incoming()) && (
        // Action: Edit post contents by author
        (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'attachments'])) ||
        // Action: Pin/unpin post by leader
        (isLeaderOrAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isPinned'])) ||
        // Action: Like/unlike or comment addition by general signed-in cohort members
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['comments']))
      );
      allow delete: if isLeaderOrAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }

    function isValidPost(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 50000
        && data.category is string
        && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() <= 100
        && data.authorRole is string
        && data.authorAvatar is string
        && data.likes is list
        && data.comments is list
        && data.timestamp is string;
    }

    // --- OCIA REGISTRATIONS RULES ---
    match /ocia_registrations/{registrationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isLeaderOrAdmin();
    }

    // --- POLLS RULES ---
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(pollId) && isValidPoll(incoming());
      allow update: if isSignedIn() && isValidId(pollId) && isValidPoll(incoming()) && (
        // Action: Vote (any member can vote, which modifies the options list with vote counts)
        incoming().diff(existing()).affectedKeys().hasOnly(['options'])
      );
      allow delete: if isLeaderOrAdmin() || (isSignedIn() && existing().authorId == request.auth.uid);
    }

    function isValidPoll(data) {
      return data.id is string && data.id.size() <= 128
        && data.question is string && data.question.size() <= 500
        && data.options is list
        && data.authorId == request.auth.uid
        && data.authorName is string && data.authorName.size() <= 100
        && data.authorRole is string
        && data.authorAvatar is string
        && data.timestamp is string;
    }
  }
}
